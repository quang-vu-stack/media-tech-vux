# MEDIA TECH VUS v14 — backend container (ONE replica when worker is enabled)
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    PORT=4000

# Install only production dependencies for the API workspace.
COPY package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm install --omit=dev --no-audit --no-fund --workspace @vus/api \
    && npm cache clean --force

COPY apps/api/src apps/api/src
USER node
EXPOSE 4000
# Liveness: request admission; /ready is used by Compose for actual database readiness.
HEALTHCHECK --interval=30s --timeout=7s --start-period=30s --retries=3 \
 CMD node -e "fetch('http://127.0.0.1:4000/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/src/index.js"]
